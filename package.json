{
  "name": "portfolio-cicd",
  "version": "1.0.0",
  "description": "Portfolio website with CI/CD pipeline using GitHub Actions",
  "main": "src/script.js",
  "scripts": {
    "lint": "eslint \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest --coverage",
    "build": "node scripts/build.js",
    "start": "npx serve dist -p 3000"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageReporters": ["text", "lcov"]
  }
}
